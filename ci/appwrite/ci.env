# ── NEU MIT APPWRITE 2.6.2 ──────────────────────────────────────────────────
# PHP-Speichergrenze JEDES Appwrite-Prozesses (API, Realtime, Worker, Tasks);
# das Upgrade-Werkzeug schreibt denselben Default in die Instanz-.env.
_APP_MEMORY_LIMIT="512M"
