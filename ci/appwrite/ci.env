_APP_ENV="production"
_APP_LOCALE="en"
_APP_OPTIONS_ABUSE="disabled"
_APP_OPTIONS_FORCE_HTTPS="disabled"
_APP_OPTIONS_FUNCTIONS_FORCE_HTTPS="disabled"
_APP_OPTIONS_ROUTER_FORCE_HTTPS="disabled"
_APP_OPTIONS_ROUTER_PROTECTION="disabled"
# _APP_OPENSSL_KEY_V1 wird je CI-Lauf ERZEUGT (e2e.yml, openssl rand) —
# das Repo ist seit 2026-08-03 öffentlich, ein Klartext-Schlüssel gehört
# nicht hinein. Lokal vor `docker compose up` selbst anhängen:
#   printf "\n_APP_OPENSSL_KEY_V1=%s\n" "$(openssl rand -hex 16)" >> ci/appwrite/ci.env
_APP_DOMAIN="localhost"
_APP_CUSTOM_DOMAIN_DENY_LIST="example.com,test.com,app.example.com"
_APP_DOMAIN_FUNCTIONS="functions.localhost"
_APP_DOMAIN_SITES="sites.localhost"
_APP_DOMAIN_TARGET="localhost"
_APP_DOMAIN_TARGET_CNAME="localhost"
_APP_DOMAIN_TARGET_AAAA="::1"
_APP_DOMAIN_TARGET_A="127.0.0.1"
_APP_DOMAIN_TARGET_CAA=
_APP_DNS="8.8.8.8"
_APP_CONSOLE_WHITELIST_ROOT="enabled"
_APP_CONSOLE_WHITELIST_EMAILS=
_APP_CONSOLE_WHITELIST_IPS=
_APP_CONSOLE_HOSTNAMES=
_APP_SYSTEM_EMAIL_NAME="Appwrite"
_APP_SYSTEM_EMAIL_ADDRESS="noreply@appwrite.io"
_APP_SYSTEM_TEAM_EMAIL="team@appwrite.io"
_APP_SYSTEM_RESPONSE_FORMAT=
_APP_SYSTEM_SECURITY_EMAIL_ADDRESS="certs@appwrite.io"
_APP_EMAIL_SECURITY=
_APP_EMAIL_CERTIFICATES=""
_APP_USAGE_STATS="disabled"
_APP_LOGGING_CONFIG=
# _APP_USAGE_*_INTERVAL gibt es seit 2.0 nicht mehr — die Nutzungszahlen laufen
# über ClickHouse-Warteschlangen (_APP_STATS_*). ClickHouse selbst wird in CI
# NICHT gestartet; die stats-Worker fehlen ebenfalls, die Warteschlangen bleiben
# also einfach liegen. Deshalb steht _APP_USAGE_STATS hier auf "disabled".
_APP_STATS_USAGE_QUEUE_NAME="v1-stats-usage"
_APP_STATS_RESOURCES_QUEUE_NAME="v1-stats-resources"
_APP_STATS_RESOURCES_INTERVAL="3600"
_APP_MAINTENANCE_RETENTION_USAGE_TTL="180"
_APP_USAGE_PASS="appwrite"
_APP_CONNECTIONS_DB_USAGE="http://appwrite:appwrite@clickhouse:8123/appwrite"
_APP_CONNECTIONS_DB_EXECUTIONS="http://appwrite:appwrite@clickhouse:8123/appwrite"
_APP_POOL_SIZE_USAGE="2"
_APP_POOL_SIZE_EXECUTIONS="2"
_APP_WORKER_PER_CORE="6"
_APP_CONSOLE_SESSION_ALERTS="disabled"
_APP_COMPRESSION_ENABLED="enabled"
_APP_COMPRESSION_MIN_SIZE_BYTES="1024"
_APP_TRUSTED_HEADERS="x-forwarded-for"
_APP_DB_ADAPTER="mariadb"
_APP_DB_HOST="mariadb"
_APP_DB_PORT="3306"
_APP_DB_SCHEMA="appwrite"
_APP_DB_USER="user"
_APP_DB_PASS="ci-password"
_APP_DB_ROOT_PASS="ci-root-password"
_APP_REDIS_HOST="redis"
_APP_REDIS_PORT="6379"
_APP_REDIS_USER=
_APP_REDIS_PASS=""
_APP_INFLUXDB_HOST="influxdb"
_APP_INFLUXDB_PORT="8086"
_APP_STATSD_HOST="telegraf"
_APP_STATSD_PORT="8125"
_APP_SMTP_HOST=""
_APP_SMTP_PORT=1025
_APP_SMTP_SECURE=
_APP_SMTP_USERNAME=
_APP_SMTP_PASSWORD=
_APP_SMS_PROVIDER=
_APP_SMS_FROM=
_APP_STORAGE_LIMIT="30000000"
_APP_STORAGE_PREVIEW_LIMIT="20000000"
_APP_STORAGE_ANTIVIRUS="disabled"
_APP_STORAGE_ANTIVIRUS_HOST="clamav"
_APP_STORAGE_ANTIVIRUS_PORT="3310"
_APP_STORAGE_DEVICE="local"
_APP_STORAGE_S3_ACCESS_KEY=
_APP_STORAGE_S3_SECRET=
_APP_STORAGE_S3_REGION="us-east-1"
_APP_STORAGE_S3_BUCKET=
_APP_STORAGE_S3_ENDPOINT=
_APP_STORAGE_DO_SPACES_ACCESS_KEY=
_APP_STORAGE_DO_SPACES_SECRET=
_APP_STORAGE_DO_SPACES_REGION="us-east-1"
_APP_STORAGE_DO_SPACES_BUCKET=
_APP_STORAGE_BACKBLAZE_ACCESS_KEY=
_APP_STORAGE_BACKBLAZE_SECRET=
_APP_STORAGE_BACKBLAZE_REGION="us-west-004"
_APP_STORAGE_BACKBLAZE_BUCKET=
_APP_STORAGE_LINODE_ACCESS_KEY=
_APP_STORAGE_LINODE_SECRET=
_APP_STORAGE_LINODE_REGION="eu-central-1"
_APP_STORAGE_LINODE_BUCKET=
_APP_STORAGE_WASABI_ACCESS_KEY=
_APP_STORAGE_WASABI_SECRET=
_APP_STORAGE_WASABI_REGION="eu-central-1"
_APP_STORAGE_WASABI_BUCKET=
_APP_FUNCTIONS_SIZE_LIMIT="30000000"
_APP_COMPUTE_SIZE_LIMIT="30000000"
_APP_FUNCTIONS_BUILD_SIZE_LIMIT="2000000000"
# Seit 2.1 der gueltige Schluessel; _APP_FUNCTIONS_BUILD_SIZE_LIMIT ist veraltet.
_APP_COMPUTE_BUILD_SIZE_LIMIT="2000000000"
_APP_FUNCTIONS_TIMEOUT="900"
_APP_FUNCTIONS_BUILD_TIMEOUT="2700"
_APP_COMPUTE_BUILD_TIMEOUT="2700"
_APP_FUNCTIONS_CONTAINERS="10"
_APP_FUNCTIONS_CPUS="0"
_APP_COMPUTE_CPUS="0"
_APP_FUNCTIONS_MEMORY="0"
_APP_COMPUTE_MEMORY="0"
_APP_FUNCTIONS_MEMORY_SWAP="0"
_APP_FUNCTIONS_RUNTIMES="node-16.0,php-8.0,python-3.9,ruby-3.0"
_APP_EXECUTOR_SECRET="your-secret-key"
_APP_EXECUTOR_HOST="http://exc1/v1"
_APP_BROWSER_HOST="http://appwrite-browser:3000/v1"
# Seit 2.1: Zuschnitt-Schwerpunkt (gravity=auto). Leer = aus; der CI-Stack
# startet appwrite-autogravity nicht.
_APP_AUTOGRAVITY_HOST=
_APP_EXECUTOR_RUNTIME_NETWORK="appwrite_runtimes"
_APP_FUNCTIONS_ENVS="node-16.0,php-7.4,python-3.9,ruby-3.0"
_APP_FUNCTIONS_INACTIVE_THRESHOLD="60"
_APP_COMPUTE_INACTIVE_THRESHOLD="60"
DOCKERHUB_PULL_USERNAME=
DOCKERHUB_PULL_PASSWORD=
DOCKERHUB_PULL_EMAIL=
OPEN_RUNTIMES_NETWORK="appwrite_runtimes"
_APP_FUNCTIONS_RUNTIMES_NETWORK="runtimes"
_APP_COMPUTE_RUNTIMES_NETWORK="runtimes"
_APP_OPEN_RUNTIMES_NFT="enabled"
_APP_DOCKER_HUB_USERNAME=
_APP_DOCKER_HUB_PASSWORD=
_APP_FUNCTIONS_MAINTENANCE_INTERVAL="3600"
_APP_COMPUTE_MAINTENANCE_INTERVAL="3600"
_APP_SITES_TIMEOUT="900"
_APP_SITES_RUNTIMES="static-1,node-22,flutter-3.29"
_APP_VCS_GITHUB_APP_NAME=
_APP_VCS_GITHUB_PRIVATE_KEY=
_APP_VCS_GITHUB_APP_ID=
_APP_VCS_GITHUB_CLIENT_ID=
_APP_VCS_GITHUB_CLIENT_SECRET=
_APP_VCS_GITHUB_WEBHOOK_SECRET=
_APP_MAINTENANCE_INTERVAL="86400"
_APP_MAINTENANCE_DELAY="0"
_APP_MAINTENANCE_START_TIME="00:00"
_APP_MAINTENANCE_RETENTION_CACHE="2592000"
_APP_MAINTENANCE_RETENTION_EXECUTION="1209600"
_APP_MAINTENANCE_RETENTION_AUDIT="1209600"
_APP_MAINTENANCE_RETENTION_AUDIT_CONSOLE="15778800"
_APP_MAINTENANCE_RETENTION_ABUSE="86400"
_APP_MAINTENANCE_RETENTION_SCHEDULES="86400"
_APP_GRAPHQL_INTROSPECTION="enabled"
_APP_GRAPHQL_MAX_BATCH_SIZE="10"
_APP_GRAPHQL_MAX_COMPLEXITY="250"
_APP_GRAPHQL_MAX_DEPTH="3"
_APP_MIGRATION_HOST="appwrite"
_APP_MIGRATIONS_FIREBASE_CLIENT_ID=
_APP_MIGRATIONS_FIREBASE_CLIENT_SECRET=
# 8080/8443 statt 80/443: der CI-Stack muss sich LOKAL neben der Entwicklungs-
# Appwrite starten lassen (Runbook-Fall „CI nachstellen"), und die belegt
# beide Standard-Ports. TLS benutzt in CI ohnehin niemand — die Tests sprechen
# http://localhost:8080.
_APP_HTTP_PORT="8080"
_APP_HTTPS_PORT="8443"
_APP_IMAGE="appwrite/appwrite"
# Muss der Version von Entwicklung UND Produktion folgen — sonst prüft die E2E
# eine Engine, die nirgends läuft. Am 2026-08-02 aufgefallen: die CI stand noch
# auf 1.9.5, während der Rest längst 1.9.6 fuhr. Seit 2026-09-14 auf 2.2.0, seit 2026-10-23 auf 2.6.1,
# seit 2026-10-27 auf 2.6.2 (Security-Release: Brotli CVE-2026-111497 im Basis-Image, Härtung).
_APP_VERSION="2.6.2"
_APP_EXECUTOR_IMAGES="openruntimes/node:v5-16.0,openruntimes/php:v5-8.0,openruntimes/python:v5-3.9,openruntimes/ruby:v5-3.0,openruntimes/static:v5-1,openruntimes/node:v5-22,openruntimes/flutter:v5-3.29"

# ── NEU MIT APPWRITE 2.0 ────────────────────────────────────────────────────
# Alle Geheimnisse sind FESTE Wegwerf-Werte: die Instanz lebt genau einen Lauf,
# und der Docker-Stack ist von aussen nicht erreichbar. Einzige Ausnahme bleibt
# _APP_OPENSSL_KEY_V1 — der wird je Lauf erzeugt (siehe Kopf dieser Datei), weil
# er als einziger Schlüssel Daten VERSCHLÜSSELT und ein Klartext-Wert im
# öffentlichen Repo ein schlechtes Vorbild wäre.
_APP_EDITION="self-hosted"
_APP_LOGGING_FORMAT="pretty"
_APP_LOCKING_ENABLED="enabled"
_APP_ROUTER_AUTO_CERTIFICATES="disabled"
_APP_OPTIONS_ABUSE_INCREASED_LIMIT_PROJECTS=
_APP_LIMIT_DATABASE_BATCH="100"
_APP_FUNCTIONS_SCHEDULE_SPREAD="0"
_APP_BUILDS_VOLUME="appwrite-builds"
_APP_EXECUTOR_CONNECTION_STORAGE="local://localhost"

# appwrite-geo: eigener Dienst seit 2.0, und der API-Container hat ein
# depends_on darauf — er MUSS in der Startliste von e2e.yml stehen.
_APP_GEO_ENDPOINT="http://appwrite-geo/v1"
_APP_GEO_SECRET="ci-geo-secret"

# jobs/orchestrator + Benachrichtigungs-Tracking: Dienste laufen in CI nicht,
# die Schlüssel müssen aber gesetzt sein, sonst warnt der API-Container beim
# Start über fehlende Konfiguration.
_APP_JOBS_HOST="http://orchestrator:8080"
_APP_JOBS_ENDPOINT="http://appwrite"
_APP_JOBS_SECRET="ci-jobs-secret"
_APP_NOTIFICATIONS_TRACKING_SECRET="ci-notifications-secret"

# DocumentsDB (MongoDB) und VectorsDB (PostgreSQL) sind in 2.0 optionale
# Zusatz-Speicher. Beide AUS — die Verbindungsdaten stehen trotzdem da, weil
# das Compose sie unbedingt durchreicht.
_APP_DOCUMENTSDB="disabled"
_APP_VECTORSDB="disabled"
_APP_EMBEDDING="disabled"
_APP_CONNECTIONS_DATABASE_DOCUMENTSDB=
_APP_CONNECTIONS_DATABASE_VECTORSDB=
_APP_DB_ADAPTER_DOCUMENTSDB="mongodb"
_APP_DB_HOST_DOCUMENTSDB="mongodb"
_APP_DB_PORT_DOCUMENTSDB="27017"
_APP_DB_SCHEMA_DOCUMENTSDB=
_APP_DB_USER_DOCUMENTSDB=
_APP_DB_PASS_DOCUMENTSDB=
_APP_DB_ADAPTER_VECTORSDB="postgresql"
_APP_DB_HOST_VECTORSDB="postgresql"
_APP_DB_PORT_VECTORSDB="5432"
_APP_DB_SCHEMA_VECTORSDB=
_APP_DB_USER_VECTORSDB=
_APP_DB_PASS_VECTORSDB=

# Console-OAuth und die neuen VCS-Anbieter (Gitea/GitLab/Bitbucket): leer.
_APP_CONSOLE_GITHUB_APP_ID=
_APP_CONSOLE_GITHUB_SECRET=
_APP_CONSOLE_GITLAB_APP_ID=
_APP_CONSOLE_GITLAB_SECRET=
_APP_CONSOLE_GITLAB_ENDPOINT=
_APP_CONSOLE_BITBUCKET_APP_ID=
_APP_CONSOLE_BITBUCKET_SECRET=
_APP_CONSOLE_GOOGLE_APP_ID=
_APP_CONSOLE_GOOGLE_SECRET=
_APP_VCS_GITEA_ENDPOINT=
_APP_VCS_GITEA_BROWSER_ENDPOINT=
