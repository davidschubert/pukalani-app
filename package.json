{
  "name": "pukalani-monorepo",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:core": "pnpm --filter @pukalani/core dev",
    "dev:app": "pnpm --filter comments dev",
    "dev:docs": "pnpm --filter @pukalani/docs dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "changelog:draft": "node --env-file=apps/comments/.env packages/admin/scripts/changelog-draft.mjs",
    "migrate": "node --experimental-strip-types scripts/migrate.mjs",
    "create-site": "node --experimental-strip-types scripts/create-site.mjs",
    "control:jobs": "node --experimental-strip-types scripts/control-jobs.mjs",
    "entitlements:keygen": "node scripts/entitlements-keygen.mjs",
    "check:manifests": "node --experimental-strip-types scripts/check-manifests.mjs",
    "brand:invite": "node --env-file=apps/branding/.env packages/brand/scripts/invite.mjs",
    "brand:revoke": "node --env-file=apps/branding/.env packages/brand/scripts/revoke.mjs",
    "brand:access": "node --env-file=apps/branding/.env packages/brand/scripts/access.mjs",
    "check:i18n-keys": "node --experimental-strip-types scripts/check-i18n-keys.mjs",
    "bilanz": "node --experimental-strip-types scripts/produkt-bilanz.mjs",
    "check:bilanz": "node --experimental-strip-types scripts/produkt-bilanz.mjs --check",
    "check:single-copy": "node scripts/check-single-copy.mjs",
    "lint:scripts": "eslint scripts",
    "check:doc-links": "node scripts/ops/verify-doc-links.mjs",
    "ops:site-env": "node scripts/ops/verify-site-env.mjs",
    "ops:schema-parity": "node scripts/ops/verify-schema-parity.mjs",
    "ops:stale-keys": "node scripts/ops/verify-stale-keys.mjs",
    "ops:instance-admins": "node scripts/ops/verify-instance-admins.mjs",
    "ops:ai-models": "node scripts/ops/verify-ai-models.mjs",
    "ops:turnstile": "node scripts/ops/verify-turnstile.mjs",
    "ops:cleanup-portfolio-legacy": "node scripts/ops/cleanup-portfolio-legacy-tables.mjs"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "catalog:",
    "eslint": "catalog:"
  }
}
