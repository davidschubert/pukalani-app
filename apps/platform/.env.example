# Appwrite — jede App nutzt ihre EIGENE Instanz (lokal: OrbStack)
# Zwei Keys (Konzept A2), beide server-only — NIE committen!
# Runtime-Key: sessions.write, users.read/write, rows.read/write, health.read
NUXT_APPWRITE_KEY=
# Migrations-Key: databases/tables/columns/indexes read+write — NUR für Migrations-
# Scripts (lokal/CI). Gehört NIE auf den laufenden App-Server (Prod).
NUXT_APPWRITE_MIGRATIONS_KEY=

NUXT_PUBLIC_APPWRITE_ENDPOINT=http://localhost/v1
NUXT_PUBLIC_APPWRITE_PROJECT_ID=
NUXT_PUBLIC_APPWRITE_DATABASE_ID=
# Storage-Bucket für Profilfotos (leer = Avatar-Upload-UI ausgeblendet)
NUXT_PUBLIC_APPWRITE_AVATARS_BUCKET=
# Storage-Bucket für GDPR-Pre-Delete-Snapshots (leer = Löschung ohne Snapshot)
NUXT_PUBLIC_APPWRITE_GDPR_BUCKET=

# Link-Basis dieser App: Mail-Links ohne Community fallen hierauf zurück (D5).
NUXT_PUBLIC_APP_URL=http://localhost:3002

# Entitlement-Zustellung (F3, optional): Dokument-URL des Control Plane +
# kid→Public-Key-Map (JSON; erzeugt pnpm entitlements:keygen). Leer = Pull aus,
# Produkt-Gates bleiben entitlement-neutral.
NUXT_ENTITLEMENTS_URL=
NUXT_ENTITLEMENTS_PUBLIC_KEYS=

# Control Plane (Projekt `control`) — Quelle der communities-Table (Host→Mandant).
# Eigener READ-ONLY-Key (Scope: rows.read), getrennt vom Pool-Runtime-Key oben.
NUXT_PLATFORM_CONTROL_ENDPOINT=http://localhost/v1
NUXT_PLATFORM_CONTROL_PROJECT_ID=
NUXT_PLATFORM_CONTROL_DATABASE_ID=main
NUXT_PLATFORM_CONTROL_KEY=

# Self-Service-Onboarding (SAAS-ROADMAP #1)
# Kontroll-Hosts dieser App (Kundenbereich, KEIN Mandant), kommagetrennt.
# Prod: account.pukalani.app · lokal: app.localhost
# (my./start. sind seit AH-1 abgeschaltet und leiten 301 weiter, s. unten;
#  app.pukalani.app ist schon am 2026-07-27 entfernt — antwortet 404.)
NUXT_PUBLIC_TENANCY_CONTROL_HOSTS=
# Kontroll-Hosts, deren `/` direkt in den Wizard führt (F12), kommagetrennt.
# Prod LEER (seit AH-1 gibt es nur `account.`) · lokal z. B. start.localhost
NUXT_PUBLIC_TENANCY_WIZARD_HOSTS=
# Abgeschaltete Kontroll-Host-Namen → 301 auf den ersten Eintrag oben,
# Pfad und Query unverändert. Prod: my.pukalani.app,start.pukalani.app
# Leer = keine Weiterleitung (die Namen antworten dann 404).
NUXT_PUBLIC_TENANCY_LEGACY_CONTROL_HOSTS=
# Basis-URL des Control Plane. Leer = Trichter antwortet 503.
NUXT_ONBOARDING_CONTROL_URL=
# Service-Secret der Naht — identisch mit NUXT_CONTROL_ONBOARDING_SECRET im Control.
NUXT_ONBOARDING_SERVICE_SECRET=

# Benachrichtigungs-Mails (notify() → Antworten, Erwähnungen, Zahlungswarnung
# eines Community-Abos). Leerer Host = Mail-Zweig aus; seit F44 sagt der Server
# das beim ersten Versuch einmal laut, damit „aus" und „vergessen" sich
# unterscheiden — in Produktion lief platform monatelang ohne SMTP, und für
# JEDE Kunden-Community ging nie eine Mail raus. Lokal Mailpit (localhost:1025).
# Die Link-Basis für Mails ohne Community steht oben als NUXT_PUBLIC_APP_URL
# (bewusst nur EINMAL in dieser Datei — ein zweiter, leerer Eintrag hat den
# ersten überschrieben und hätte jede Mail mit kaputten Links verschickt).
NUXT_SMTP_HOST=
NUXT_SMTP_PORT=
NUXT_SMTP_USER=
NUXT_SMTP_PASS=
NUXT_SMTP_FROM=

# Resend-Webhook (RS1 b): Signing Secret (whsec_…) des Webhook-Eintrags DIESER
# Site — Bounces/Beschwerden schalten Mails aus und melden Newsletter ab.
# Leer = POST /api/mail/resend-webhook antwortet 404. docs/runbooks/RESEND-WEBHOOK.md
NUXT_RESEND_WEBHOOK_SECRET=

# Resend-Tagesbudget (RS1 a): NUR-LESENDER Resend-Schlüssel (re_…) für
# `GET /usage`. Der Newsletter-Versand fragt damit vor jedem Stapel, wie viele
# Mails der Tag noch trägt (freier Tarif = 100 für ALLES, auch OTP), und hält
# an, bevor er das Anmelde-Budget mitnimmt. NICHT zum Versenden — das bleibt
# SMTP. Leer = der Versand hält jeden Stapel an. docs/runbooks/RESEND-WEBHOOK.md § 5
NUXT_RESEND_API_KEY=

# Besucherstatistik im Dashboard (Analytics v2): Plausible-API-Schlüssel für
# POST /api/v2/query. SERVER-ONLY — er liest die Zahlen JEDER Site unserer
# Instanz und gehört deshalb nie in den Browser. Leer = die Messung läuft
# weiter, im Dashboard steht „Statistik gerade nicht erreichbar".
NUXT_ANALYTICS_STATS_API_KEY=

# „Anmelden mit Google" (U14): welche Social-Login-Provider hat DIESE INSTANZ
# wirklich belegt — kommagetrennt, heute nur `google`. Leer = kein Knopf.
# ZWEITE Bedingung neben `pukalani.auth.providers` in der app.config, und
# genau deshalb steht sie hier: Client-Id und Geheimnis liegen in der
# APPWRITE-Console (Auth → Settings → Google), nicht bei uns. Die app.config
# ist Quelltext und gilt für jede Instanz, die den Layer erbt — ohne diesen
# Schalter hätte auch jede Instanz OHNE Credentials einen Knopf, der ins Leere
# führt. Erst eintragen, NACHDEM der Provider in der Console belegt ist.
# Anleitung: docs/runbooks/GOOGLE-LOGIN.md
NUXT_PUBLIC_AUTH_OAUTH_PROVIDERS=

# Standort in der Sitzungsliste (Stadt + Region): absoluter Pfad zur lokalen
# MMDB-Datei (DB-IP City Lite, ~124 MB). SERVER-ONLY, wird NICHT mit deployt —
# die Datei liegt neben der App und wird monatlich ersetzt (Cron, atomar per
# `mv`; der Leser merkt den Tausch an der mtime).
# Leer = aus: die Liste zeigt dann nur das Land, das Appwrite liefert. Kein
# Fehler, aber auch kein Hinweis — deshalb steht die Variable im Env-Wächter
# (scripts/ops/verify-site-env.mjs).
NUXT_GEO_CITY_DB_PATH=

# Orts-Verzeichnis für den Standort im Profil (Orts-Picker + optionaler
# Länder-Filter): absoluter Pfad zur lokalen TSV (GeoNames-Auszug, ~10 MB,
# erzeugt von scripts/geo/build-geonames-cities.mjs). SERVER-ONLY, wird NICHT
# mit deployt — die Datei liegt neben der App.
# NICHT dieselbe Datei wie NUXT_GEO_CITY_DB_PATH darüber: das ist die
# IP-Datenbank („wo war diese Sitzung?"), das hier ein Namensverzeichnis
# („wo wohnst du?"). Lizenz: GeoNames, CC BY 4.0 (Attribution steht im Feld).
# Leer = der Picker findet nichts. Kein Fehler, aber auch kein Hinweis —
# deshalb steht die Variable im Env-Wächter (scripts/ops/verify-site-env.mjs).
NUXT_GEO_CITIES_PATH=

