# VORLAGE: Pool-Site — EINE App für viele Communities (OPS-003).
# Beispiel: platform.pukalani.app mit dem Wildcard *.pukalani.app.
# Lies den Kopf von einzel-site.conf.template (keine Schutz-Kopfzeilen im
# Webserver; was Pflicht ist und was Ploi umschreiben darf).
#
# Platzhalter: {{SITE}} Name der Ploi-Site · {{ZONE}} die Zone des Wildcards ·
# {{PORT}} Port der App.
#
# ZERTIFIKAT: das Wildcard liegt in der geteilten Lineage der Zone. NIE auf
# einer anderen Site derselben Zone ein Zertifikat anfordern
# (.claude/rules/hosts-ops.md, TLS-Fallen).
# KUNDENDOMAINS bekommen je Name eine eigene Datei:
# pool-kundendomain.conf.template.

# Ploi Webserver Configuration, do not remove!
include /etc/nginx/ploi/{{SITE}}/before/*;

server {
    root /home/ploi/{{SITE}}/public;
    # PFLICHT (feste-namen): die Site und ihr Wildcard — NICHT `_`. Welche
    # Community zu einem Namen gehört, entscheidet die App (unbekannt ⇒ 404).
    server_name {{SITE}} *.{{ZONE}};

    # Zertifikat und TLS-Einstellungen pflegt Ploi (Zertifikat anfordern, Alias):
    # diese Zeilen sind KEINE Pflicht-Zeilen und sehen nach einem Handgriff in
    # Ploi anders aus (`listen 443 ssl` + `ssl_certificate` statt des include).
    include /etc/nginx/ssl/{{SITE}};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_dhparam /etc/nginx/dhparams.pem;

    charset utf-8;

    # Ploi Configuration, do not remove!
    include /etc/nginx/ploi/{{SITE}}/server/*;

    # PFLICHT (host, client-adresse-real-ip, client-adresse-xff, protokoll, frist, port)
    location / {
        proxy_pass http://127.0.0.1:{{PORT}};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $http_connection;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # PFLICHT (punkt-dateien): keine Datei mit Punkt am Anfang ausliefern.
    location ~ /\.(?!well-known).* {
        deny all;
    }

    # PFLICHT (zugriffs-log): ausdrücklich aus. Ohne diese Zeile schreibt das
    # globale Log des Servers mit (Adresse, ganze Anfragezeile, 52 Tage).
    # Soll eine Site mitschreiben: ops/nginx/zugriffs-log.snippet.
    access_log off;
    error_log  /var/log/nginx/{{SITE}}-error.log error;
}

# Ploi Webserver Configuration, do not remove!
include /etc/nginx/ploi/{{SITE}}/after/*;
